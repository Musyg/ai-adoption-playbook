{
  "name": "ai-adoption-playbook-site",
  "version": "0.2.2",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "build:static": "npm run build && npm run export:static",
    "export:static": "node scripts/clean-static-export.mjs && vite build --config vite.static.config.ts && node scripts/finalize-static-export.mjs",
    "preview:static": "vite preview --config vite.static.config.ts",
    "start": "vinext start",
    "test": "npm run build:static && node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "test:hosted": "node --test tests/hosted-export.check.mjs",
    "verify": "npm run lint && npm run typecheck && npm test && npm run test:browser",
    "typecheck": "tsc --noEmit --incremental false",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern static-dist"
  },
  "dependencies": {
    "entities": "8.1.0",
    "github-slugger": "2.0.0",
    "marked": "18.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sanitize-html": "2.18.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.5",
    "@next/eslint-plugin-next": "16.4.2",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "react-server-dom-webpack": "19.3.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vinext": "1.2.1",
    "vite": "8.3.4"
  },
  "overrides": {
    "brace-expansion@1": "1.1.21",
    "brace-expansion@5": "5.0.12",
    "braces": "npm:@dieub/braces-depth-guard@3.0.3-pn.0",
    "fast-uri": "3.1.9",
    "source-map-js": "1.2.2",
    "fflate@0.7": "0.7.5"
  },
  "type": "module"
}
